AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=your-video-bucket

# Callback authentication header:
# X-Analyzer-Secret: {ANALYZER_SECRET}
ANALYZER_SECRET=change-me
# CALLBACK_SECRET=change-me

# Inference accelerator (optional; auto-detected when unset).
# Apple Silicon auto-resolves to ("mps", ["CoreMLExecutionProvider", "CPUExecutionProvider"]).
# Set both to switch to CUDA, or to "cpu" / "CPUExecutionProvider" to force CPU.
# FACE_ANALYZER_DEVICE=mps
# FACE_ANALYZER_ONNX_PROVIDERS=CoreMLExecutionProvider,CPUExecutionProvider

# S3 multipart download tuning (optional; sensible defaults applied).
# S3_DOWNLOAD_MAX_CONCURRENCY=16
# S3_DOWNLOAD_CHUNKSIZE_MB=16
