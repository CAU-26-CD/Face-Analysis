# .env 파일은 애플리케이션의 환경 변수를 정의하는 데 사용됩니다. 이 파일은 보통 프로젝트 루트 디렉토리에 위치하며, 애플리케이션이 실행될 때 필요한 설정 값을 제공합니다. 아래는 .env 파일의 예시입니다.

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/rehearsal_db
SECRET_KEY=rehearsal2026!platform@capstone
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Storage (로컬 or S3)
UPLOAD_DIR=./uploads
MAX_VIDEO_SIZE_MB=2048
